#!/usr/bin/env bash
set -euo pipefail

checks=(
  'com/docs|http://127.0.0.1:5106/health'
  'com/help|http://127.0.0.1:5108/health'
  'com/info|http://127.0.0.1:5103/health'
  'com/news|http://127.0.0.1:5107/health'
  'org/docs|http://127.0.0.1:5306/health'
  'org/help|http://127.0.0.1:5308/health'
  'org/info|http://127.0.0.1:5303/health'
  'org/news|http://127.0.0.1:5307/health'
  'app/docs|http://127.0.0.1:5406/health'
  'app/help|http://127.0.0.1:5408/health'
  'app/info|http://127.0.0.1:5403/health'
  'app/news|http://127.0.0.1:5407/health'
)

failed=0
for check in "${checks[@]}"; do
  name=${check%%|*}
  url=${check#*|}
  if curl --fail --silent --show-error --max-time 10 --output /dev/null "${url}"; then
    echo "PASS ${name} ${url}"
  else
    echo "FAIL ${name} ${url}" >&2
    failed=1
  fi
done
exit "${failed}"
