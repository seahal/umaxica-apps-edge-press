{
  "name": "umaxica-apps-edge-press-news-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EDGE_LOCAL_NODE_RUNTIME=1 CLOUDFLARE_ENV=local PUBLIC_REGION=jp vp dev --port 5107 --host",
    "dev:vpc": "CLOUDFLARE_ENV=vpc PUBLIC_REGION=jp vp dev --port 5107 --host",
    "build": "CLOUDFLARE_ENV= PUBLIC_REGION=jp vp build",
    "preview": "pnpm run build && CLOUDFLARE_ENV= vp preview --port 5107",
    "deploy": "pnpm run build && CLOUDFLARE_ENV= wrangler deploy",
    "deploy:upload": "pnpm run build && CLOUDFLARE_ENV= wrangler versions upload",
    "deploy:promote": "CLOUDFLARE_ENV= wrangler versions deploy --config wrangler.jsonc --yes",
    "upload:ci": "pnpm run build && CLOUDFLARE_ENV= wrangler versions upload",
    "deploy:ci": "pnpm run build && CLOUDFLARE_ENV= wrangler deploy",
    "cf-typegen": "CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "i18n:compile": "pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-edge-locale baseLocale --output-structure locale-modules --emit-ts-declarations --no-emit-git-ignore --no-emit-readme --no-emit-prettier-ignore",
    "pretypecheck": "pnpm run i18n:compile",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "pretest": "pnpm run i18n:compile",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "pretest:stress": "pnpm run i18n:compile",
    "test:stress": "vp test run --sequence.shuffle --no-cache",
    "test:api": "node api/run.mjs",
    "serve:api": "CLOUDFLARE_ENV=local PUBLIC_REGION=jp vp build && CLOUDFLARE_ENV=local vp preview --port 5107 --strictPort",
    "test:e2e": "playwright test",
    "preknip": "pnpm run i18n:compile",
    "knip": "knip --treat-config-hints-as-errors",
    "prelint": "pnpm run i18n:compile",
    "lint": "vp lint --config .oxlintrc.json --type-aware --fix .",
    "format": "vp fmt --config .oxfmtrc.json . --write",
    "format:check": "vp fmt --config .oxfmtrc.json . --check",
    "check": "pnpm run check:static && pnpm run test",
    "precheck:generated": "pnpm run i18n:compile",
    "check:generated": "pnpm run cf-typegen && CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts --check",
    "check:static": "pnpm run format:check && pnpm run lint:check && pnpm run check:generated && pnpm run typecheck && pnpm run knip",
    "check:size": "size-limit",
    "lint:check": "vp lint --config .oxlintrc.json --type-aware .",
    "prelint:check": "pnpm run i18n:compile"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-m-function-matcher": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@orangeopensource/hurl": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "size-limit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ]
}
