{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "incremental": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // The quality policy every deployment unit shares, byte-identical in all
    // thirteen tsconfigs. It is repeated rather than `extends`-ed: a unit has to
    // stay valid when it is lifted out into its own repository, which
    // `test/deployment-unit-boundaries.test.ts` enforces for every other per-unit
    // config too. What is deliberately NOT standardised is directly above this
    // block — `target`, `module`, `lib`, `jsx`, `jsxImportSource`, `types`,
    // `plugins`, `paths` are framework mechanics and differ by design between the
    // standalone TanStack Start units.
    //
    // `useUnknownInCatchVariables` is not listed: TypeScript 7 implies it from
    // `strict`, and repeating a default is a line that can silently stop meaning
    // anything.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Keep dependency declaration checking focused on this unit's source code.
    // Workers runtime types overlap with DOM and React declaration packages;
    // the project source remains under the strict checks above.
    "skipLibCheck": true
  },
  "include": [
    "cloudflare-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*",
    "e2e/**/*",
    "*.ts",
    "*.d.ts"
  ],
  "exclude": ["node_modules"]
}
